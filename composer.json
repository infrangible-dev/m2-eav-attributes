{
    "name": "infrangible/m2-eav-attributes",
    "description": "Adds admin screens to create, edit and delete category, customer and customer address attributes, just like product attributes in standard Magento.",
    "type": "magento2-module",
    "version": "1.0.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Admin tools",
        "Customers",
        "Catalog",
        "category attributes in the admin",
        "customer attributes",
        "customer address attributes"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-eav-attributes",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.infrangible.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~101.0.0|~102.0.0|~103.0.0",
        "infrangible/m2-backend-widget": "~3.7.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\EavAttributes\\": "src"
        }
    }
}
